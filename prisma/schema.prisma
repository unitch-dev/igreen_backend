// ─── ORGANIZATION ─────────────────────────────────────────────────────────────

model Organization {
  id                            String       @id @default(uuid())
  name                          String
  slug                          String       @unique
  logoUrl                       String?
  address                       String?
  phone                         String?
  email                         String?
  website                       String?
  currency                      CurrencyCode @default(INR)
  isActive                      Boolean      @default(true)
  allowAnonymousServiceRequests Boolean      @default(true)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  createdById                   String?
  updatedById                   String?

  departments       Department[]
  designations      Designation[]
  employees         Employee[]
  roles             Role[]
  leaveTypes        LeavePolicy[]
  leavePolicyRules  LeavePolicyRule[]
  holidays          Holiday[]
  payrollStructures PayrollStructure[]
  taxRules          TaxRule[]
  payrollRuns       PayrollRun[]
  incentiveRules    IncentiveRule[]
  greenThanksConfig GreenThanksConfig[]
  notices           Notice[]
  assets            Asset[]
  insurancePolicies InsurancePolicy[]
  disciplinaryMemos DisciplinaryMemo[]
  exitRecords       ExitRecord[]
  onboardingLinks   OnboardingLink[]
  chatRooms         ChatRoom[]
  serviceRequests   ServiceRequest[]
  performanceCycles PerformanceCycle[]
  subscription      OrganizationSubscription?
  invoices          Invoice[]
  dashboardConfigs  DashboardConfig[]
  workLocations     WorkLocation[]
  odRecords         OdRecord[]
  kpis              Kpi[]
  zones             Zone[]
  globalLeaves      GlobalLeave[]

  @@map("organizations")
}

// ─── ROLES & PERMISSIONS ──────────────────────────────────────────────────────

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  permissions    Json     @default("[]")
  isSystemRole   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─── USER (AUTH) ──────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  organizationId     String
  employeeId         String?   @unique
  email              String
  phone              String?
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee         Employee?         @relation(fields: [employeeId], references: [id])
  userRoles        UserRole[]
  loginHistory     LoginHistory[]
  deviceTokens     DeviceToken[]
  dashboardConfigs DashboardConfig[]

  @@unique([organizationId, email])
  @@map("users")
}

model LoginHistory {
  id         String    @id @default(uuid())
  userId     String
  ipAddress  String?
  deviceInfo String?
  userAgent  String?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  status     String    @default("success")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ─── ORGANIZATION STRUCTURE ───────────────────────────────────────────────────

model Department {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  parentId       String?
  headEmployeeId String?
  hierarchyLevel Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  parent       Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children     Department[]  @relation("DepartmentHierarchy")
  designations Designation[]
  employees    Employee[]
  chatRooms    ChatRoom[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Designation {
  id                 String    @id @default(uuid())
  organizationId     String
  departmentId       String
  name               String
  level              Int       @default(0)
  payrollStructureId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  department       Department        @relation(fields: [departmentId], references: [id])
  payrollStructure PayrollStructure? @relation("DesignationPayrollStructure", fields: [payrollStructureId], references: [id])
  employees        Employee[]
  kpis             Kpi[]

  @@map("designations")
}

model TaxRule {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  code               String?
  type               String
  calculationType    String    @default("PERCENTAGE")
  applicableOn       String    @default("GROSS")
  isStatutory        Boolean   @default(false)
  config             Json
  applicabilityRules Json?
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("tax_rules")
}

model PayrollStructure {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  components     Json
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  designations Designation[] @relation("DesignationPayrollStructure")

  @@map("payroll_structures")
}

// ─── EMPLOYEE ─────────────────────────────────────────────────────────────────

model Employee {
  id                          String         @id @default(uuid())
  organizationId              String
  empCode                     String
  firstName                   String
  lastName                    String
  email                       String?
  phone                       String
  dateOfBirth                 DateTime?
  gender                      String?
  departmentId                String
  designationId               String
  reportingManagerId          String?
  payrollStructureId          String?
  leavePolicyId               String?
  zoneId                      String?
  employmentType              EmploymentType @default(FULL_TIME)
  status                      EmployeeStatus @default(PRE_BOARDING)
  joiningDate                 DateTime?
  probationEndDate            DateTime?
  bankDetails                 Json?
  emergencyContact            Json?
  documents                   Json?
  pfNumber                    String?
  esiNumber                   String?
  uanNumber                   String?
  address                     Json?
  profilePhotoUrl             String?
  nationality                 String?
  workLocation                String?
  bloodGroup                  String?
  healthInfo                  Json?
  previousEmployment          Json?
  referenceContacts           Json?
  deletedAt                   DateTime?
  flaggedForTerminationReview Boolean        @default(false)
  terminationReviewFlaggedAt  DateTime?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  createdById                 String?
  updatedById                 String?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  department       Department        @relation(fields: [departmentId], references: [id])
  designation      Designation       @relation(fields: [designationId], references: [id])
  reportingManager Employee?         @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates     Employee[]        @relation("ManagerSubordinates")
  payrollStructure PayrollStructure? @relation(fields: [payrollStructureId], references: [id])
  leavePolicy      LeavePolicy?      @relation(fields: [leavePolicyId], references: [id])
  zone             Zone?             @relation(fields: [zoneId], references: [id])
  user             User?

  leaveBalances       LeaveBalance[]
  leaveApplications   LeaveApplication[]
  attendanceLogs      AttendanceLog[]
  liveLocations       LiveLocation[]
  odRecords           OdRecord[]
  payrollEntries      PayrollEntry[]
  loans               LoanApplication[]
  todos               TodoTask[]
  incentiveLedger     IncentiveLedger[]
  greenThanksSent     GreenThanks[]       @relation("GreenThanksSender")
  greenThanksReceived GreenThanks[]       @relation("GreenThanksReceiver")
  chatRoomMembers     ChatRoomMember[]
  noticeReads         NoticeRead[]
  performanceRatings  PerformanceRating[]
  serviceRequests     ServiceRequest[]
  assetAssignments    AssetAssignment[]
  disciplinaryMemos   DisciplinaryMemo[]
  exitRecord          ExitRecord?
  employeeInsurance   EmployeeInsurance[]
  reminders           Reminder[]
  onboardingLink      OnboardingLink?
  employeeKpis        EmployeeKpi[]

  @@unique([organizationId, empCode])
  @@map("employees")
}

model OnboardingLink {
  id                    String           @id @default(uuid())
  organizationId        String
  token                 String           @unique
  email                 String
  phone                 String
  candidateName         String?
  expiresAt             DateTime
  usedAt                DateTime?
  submissionData        Json?
  status                OnboardingStatus @default(PENDING)
  hrNotes               String?          @db.Text
  reviewedById          String?
  reviewedAt            DateTime?
  activatedById         String?
  activatedAt           DateTime?
  employeeId            String?          @unique
  jobTitle              String?
  departmentName        String?
  workLocation          String?
  prefillJoiningDate    DateTime?
  prefillEmploymentType String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdById           String?
  updatedById           String?

  organization Organization           @relation(fields: [organizationId], references: [id])
  employee     Employee?              @relation(fields: [employeeId], references: [id])
  transitions  OnboardingTransition[]

  @@map("onboarding_links")
}

model OnboardingTransition {
  id               String           @id @default(uuid())
  onboardingLinkId String
  fromStatus       OnboardingStatus
  toStatus         OnboardingStatus
  actorId          String?
  actorType        String           @default("HR")
  notes            String?          @db.Text
  occurredAt       DateTime         @default(now())

  onboardingLink OnboardingLink @relation(fields: [onboardingLinkId], references: [id], onDelete: Cascade)

  @@index([onboardingLinkId, occurredAt])
  @@map("onboarding_transitions")
}

// ─── LEAVE ────────────────────────────────────────────────────────────────────

// A LeavePolicy is a named bundle (e.g. "Standard Policy") assigned to an
// employee via the existing Employee.leavePolicyId. It groups multiple
// LeavePolicyType entries (CL, PL, SL, ...), each with its own accrual/
// entitlement rules — previously a policy was hard-locked to one leaveType.
model LeavePolicy {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization      @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  types        LeavePolicyType[]
  rules        LeavePolicyRule[]

  @@map("leave_policies")
}

model LeavePolicyType {
  id                 String    @id @default(uuid())
  leavePolicyId      String
  leaveType          LeaveType
  name               String?
  daysPerYear        Float
  carryForwardMax    Float     @default(0)
  accrualType        String    @default("monthly")
  isEncashable       Boolean   @default(false)
  isLopEligible      Boolean   @default(true)
  minAdvanceDays     Int       @default(0)
  maxConsecutiveDays Int?
  allowedInProbation Boolean   @default(false)
  genderRestriction  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  leavePolicy     LeavePolicy        @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  balances        LeaveBalance[]
  applications    LeaveApplication[]
  serviceRequests ServiceRequest[]

  @@unique([leavePolicyId, leaveType])
  @@map("leave_policy_types")
}

model LeaveBalance {
  id                 String @id @default(uuid())
  employeeId         String
  leavePolicyTypeId  String
  year               Int
  entitledDays       Float
  takenDays          Float  @default(0)
  carriedForwardDays Float  @default(0)
  balanceDays        Float

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicyType LeavePolicyType @relation(fields: [leavePolicyTypeId], references: [id])

  @@unique([employeeId, leavePolicyTypeId, year])
  @@map("leave_balances")
}

model LeaveApplication {
  id                String      @id @default(uuid())
  employeeId        String
  leavePolicyTypeId String
  fromDate          DateTime
  toDate            DateTime
  days              Float
  reason            String?
  status            LeaveStatus @default(PENDING)
  approverId        String?
  rejectionNote     String?
  isSpecial         Boolean     @default(false)
  appliedAt         DateTime    @default(now())
  decidedAt         DateTime?
  createdById       String?

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicyType LeavePolicyType @relation(fields: [leavePolicyTypeId], references: [id])
  serviceRequest  ServiceRequest?

  @@map("leave_applications")
}

model Zone {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  globalLeaves GlobalLeave[] @relation("GlobalLeaveZones")

  @@unique([organizationId, name])
  @@map("zones")
}

// Org-wide (or zone-scoped) leave day distinct from the per-employee Holiday
// calendar — bulk-uploadable, tagged to zero or more Zones. An employee sees
// a GlobalLeave on their calendar when their Zone matches one of its tagged
// zones, or unconditionally when `appliesToAll` is set.
model GlobalLeave {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  date           DateTime
  appliesToAll   Boolean  @default(false)
  createdAt      DateTime @default(now())
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  zones        Zone[]       @relation("GlobalLeaveZones")

  @@map("global_leaves")
}

model LeavePolicyRule {
  id             String    @id @default(uuid())
  organizationId String
  leavePolicyId  String
  name           String
  ruleType       String
  conditionLogic String    @default("AND")
  conditions     Json
  action         Json
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  leavePolicy  LeavePolicy  @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@map("leave_policy_rules")
}

model Holiday {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  date           DateTime
  type           String   @default("national")
  createdAt      DateTime @default(now())
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("holidays")
}

// ─── ATTENDANCE ───────────────────────────────────────────────────────────────

model AttendanceLog {
  id                   String           @id @default(uuid())
  employeeId           String
  date                 DateTime         @db.Date
  checkInAt            DateTime?
  checkOutAt           DateTime?
  checkInLat           Float?
  checkInLng           Float?
  checkOutLat          Float?
  checkOutLng          Float?
  checkInLocationName  String?
  checkOutLocationName String?
  source               AttendanceSource @default(MOBILE)
  status               AttendanceStatus @default(PRESENT)
  totalHours           Float?
  overtimeHours        Float?
  approvedBy           String?
  // @db.Text: requestCorrection() JSON-encodes {type, reason, requestedCheckIn,
  // requestedCheckOut, requestedAt, requestedBy} into this column — a plain
  // VARCHAR(191) (Prisma's String default) silently truncates/errors on any
  // reason longer than a few words (the JSON envelope alone is ~140 chars
  // before the reason text). Caught by the attendance maker-checker e2e
  // regression; see docs/known-issues.md.
  notes                String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?
  updatedById          String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendance_logs")
}

model LiveLocation {
  id         String   @id @default(uuid())
  employeeId String
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, recordedAt])
  @@map("live_locations")
}

model WorkLocation {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  lat            Float
  lng            Float
  radiusMeters   Float
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("work_locations")
}

model OdRecord {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime @db.Date
  reason         String?
  totalMinutes   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  organization Organization      @relation(fields: [organizationId], references: [id])
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries      OdLocationEntry[]

  @@unique([employeeId, date])
  @@map("od_records")
}

model OdLocationEntry {
  id           String   @id @default(uuid())
  odRecordId   String
  lat          Float
  lng          Float
  locationName String?
  minutes      Int
  recordedAt   DateTime @default(now())

  odRecord OdRecord @relation(fields: [odRecordId], references: [id], onDelete: Cascade)

  @@map("od_location_entries")
}

// ─── PAYROLL ──────────────────────────────────────────────────────────────────

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  month          Int
  year           Int
  status         PayrollRunStatus @default(DRAFT)
  initiatedBy    String?
  processedAt    DateTime?
  approvedAt     DateTime?
  disbursedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdById    String?
  updatedById    String?

  organization Organization   @relation(fields: [organizationId], references: [id])
  entries      PayrollEntry[]

  @@unique([organizationId, month, year])
  @@map("payroll_runs")
}

model PayrollEntry {
  id                  String   @id @default(uuid())
  payrollRunId        String
  employeeId          String
  workingDays         Int
  presentDays         Float
  lopDays             Float    @default(0)
  basicSalary         Float    @default(0)
  hra                 Float    @default(0)
  specialAllowance    Float    @default(0)
  educationAllowance  Float    @default(0)
  otherAllowances     Float    @default(0)
  incentiveAmount     Float    @default(0)
  cumulativeIncentive Float    @default(0)
  overtimeAmount      Float    @default(0)
  travelAllowance     Float    @default(0)
  bonus               Float    @default(0)
  greenThanksAmount   Float    @default(0)
  grossSalary         Float    @default(0)
  pfEmployee          Float    @default(0)
  pfEmployer          Float    @default(0)
  esiEmployee         Float    @default(0)
  esiEmployer         Float    @default(0)
  professionalTax     Float    @default(0)
  tds                 Float    @default(0)
  loanDeduction       Float    @default(0)
  advanceDeduction    Float    @default(0)
  otherDeductions     Float    @default(0)
  netSalary           Float    @default(0)
  remarks             String?  @db.Text
  payslipUrl          String?
  status              String   @default("generated")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?
  updatedById         String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payroll_entries")
}

// ─── LOANS ────────────────────────────────────────────────────────────────────

