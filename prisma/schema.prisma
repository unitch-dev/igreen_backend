// ─── CHAT ─────────────────────────────────────────────────────────────────────

model ChatRoom {
  id             String       @id @default(uuid())
  organizationId String
  type           ChatRoomType @default(DIRECT)
  name           String?
  departmentId   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  createdById    String?

  organization Organization     @relation(fields: [organizationId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  members      ChatRoomMember[]
  messages     ChatMessage[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String    @id @default(uuid())
  roomId     String
  employeeId String
  role       String    @default("member")
  joinedAt   DateTime  @default(now())
  revokedAt  DateTime?

  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([roomId, employeeId])
  @@map("chat_room_members")
}

model ChatMessage {
  id          String    @id @default(uuid())
  roomId      String
  senderId    String
  content     String?   @db.Text
  messageType String    @default("text")
  fileUrl     String?
  fileName    String?
  sentAt      DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ─── NOTICES ──────────────────────────────────────────────────────────────────

model Notice {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  body           String    @db.Text
  status         String    @default("draft")
  targetType     String    @default("ALL")
  targetRoles    Json?
  targetDepts    Json?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  expiresAt      DateTime?
  attachmentUrl  String?
  attachmentKey  String?
  attachmentName String?
  pushSent       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  reads        NoticeRead[]

  @@map("notices")
}

model NoticeRead {
  noticeId   String
  employeeId String
  readAt     DateTime @default(now())

  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([noticeId, employeeId])
  @@map("notice_reads")
}

// ─── PERFORMANCE ──────────────────────────────────────────────────────────────

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model PerformanceCycle {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         PerformanceCycleStatus @default(DRAFT)
  closedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  createdById    String?
  updatedById    String?

  organization Organization        @relation(fields: [organizationId], references: [id])
  ratings      PerformanceRating[]

  @@unique([organizationId, name])
  @@map("performance_cycles")
}

model PerformanceRating {
  id                     String   @id @default(uuid())
  cycleId                String
  employeeId             String
  ratedBy                String
  rating                 Float
  comments               String?  @db.Text
  isEligibleForIncrement Boolean  @default(false)
  submittedAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdById            String?
  updatedById            String?

  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, employeeId])
  @@map("performance_ratings")
}

model Kpi {
  id             String   @id @default(uuid())
  organizationId String
  designationId  String
  title          String
  description    String?  @db.Text
  targetValue    Float?
  unit           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  designation  Designation   @relation(fields: [designationId], references: [id])
  assignments  EmployeeKpi[]

  @@unique([organizationId, designationId, title])
  @@map("kpis")
}

enum EmployeeKpiStatus {
  PENDING
  IN_PROGRESS
  ACHIEVED
  MISSED
}

model EmployeeKpi {
  id            String            @id @default(uuid())
  employeeId    String
  kpiId         String
  achievedValue Float?
  status        EmployeeKpiStatus @default(PENDING)
  assignedAt    DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdById   String?
  updatedById   String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kpi      Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([employeeId, kpiId])
  @@map("employee_kpis")
}

// ─── SERVICE REQUESTS ─────────────────────────────────────────────────────────

model ServiceRequest {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String?
  category       ServiceRequestCategory
  title          String
  description    String                 @db.Text
  priority       ServiceRequestPriority @default(MEDIUM)
  status         ServiceRequestStatus   @default(OPEN)
  assignedTo     String?
  slaDeadline    DateTime?
  isAnonymous    Boolean                @default(false)
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  createdById    String?
  updatedById    String?

  // Only populated when category === SPECIAL_LEAVE: a manager files the
  // request on the employee's behalf; approving it (status -> RESOLVED)
  // auto-creates an approved LeaveApplication for these dates, bypassing
  // the normal balance-sufficiency check since it's a discretionary grant.
  leavePolicyTypeId  String?
  leaveFromDate      DateTime?
  leaveToDate        DateTime?
  leaveDays          Float?
  leaveApplicationId String?   @unique

  organization     Organization            @relation(fields: [organizationId], references: [id])
  employee         Employee?               @relation(fields: [employeeId], references: [id])
  leavePolicyType  LeavePolicyType?        @relation(fields: [leavePolicyTypeId], references: [id])
  leaveApplication LeaveApplication?       @relation(fields: [leaveApplicationId], references: [id])
  comments         ServiceRequestComment[]

  @@map("service_requests")
}

model ServiceRequestComment {
  id               String   @id @default(uuid())
  serviceRequestId String
  authorId         String?
  content          String   @db.Text
  createdAt        DateTime @default(now())
  createdById      String?

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@map("service_request_comments")
}

// ─── ASSETS ───────────────────────────────────────────────────────────────────

model Asset {
