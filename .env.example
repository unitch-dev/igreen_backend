# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database (MySQL)
DATABASE_URL="mysql://hrms_user:hrms_password@localhost:3306/hrms_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Platform JWT (for platform admin portal)
PLATFORM_JWT_SECRET=your-platform-jwt-secret-here
PLATFORM_JWT_EXPIRES_IN=8h

# File Storage — local disk only
STORAGE_LOCAL_DIR=uploads

# SMS Gateway (SMSHorizon) — only required in production; OTPs/SMS are logged to console in development
# SMSHORIZON_API_KEY / SMSHORIZON_USER / SMSHORIZON_SENDER_ID are the account credentials.
#
# Each SMSHORIZON_TID_* value is a DLT-approved template id registered on the SMSHorizon
# dashboard. Indian DLT rules require the SMS body sent with a given `tid` to match the
# registered template text EXACTLY. The 5 templates used by this codebase are:
#   1. SMSHORIZON_TID_OTP (auth.service.ts sendOtp):
#        "Your IGreen HRMS login OTP is: ${otp}. Valid for 5 minutes."
#   2. SMSHORIZON_TID_ONBOARDING_WELCOME (employees/jobs/onboarding.processor.ts handleWelcome):
#        "Welcome! Your Employee ID: ${empCode}. Login: ${email}, Temp Password: ${tempPassword}. Change password on first login."
#   3. SMSHORIZON_TID_ONBOARDING_INVITE (employees/jobs/onboarding.processor.ts handleInvite):
#        "You've been invited to join the team. Complete your onboarding at: ${link}"
#   4. SMSHORIZON_TID_EMPLOYEE_INVITE (employees/jobs/employees.processor.ts handleOnboardingInvite):
#        "Welcome! Your Employee ID: ${empCode}. Email: ${email}, Temp Password: ${tempPassword}. Change password on first login."
#   5. SMSHORIZON_TID_EMPLOYEE_WELCOME (employees/jobs/employees.processor.ts handleWelcome):
#        "Welcome ${firstName}! Your HRMS account (${empCode}) is now active. Login at: ${loginUrl}"
SMSHORIZON_API_KEY=
SMSHORIZON_USER=
SMSHORIZON_SENDER_ID=
SMSHORIZON_TID_OTP=
SMSHORIZON_TID_ONBOARDING_WELCOME=
SMSHORIZON_TID_ONBOARDING_INVITE=
SMSHORIZON_TID_EMPLOYEE_INVITE=
SMSHORIZON_TID_EMPLOYEE_WELCOME=

# Legacy/rollback only — old Fast2SMS integration, no longer used unless code is reverted
FAST2SMS_API_KEY=

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# App URL (used for onboarding links)
APP_URL=http://localhost:3001
